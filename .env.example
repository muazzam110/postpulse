# Copy to .env (repo root). Never commit .env.
# --- Backend ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/copilot
FRONTEND_ORIGIN=http://localhost:5173
# Required in production: a random string of 32+ characters (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
SESSION_SECRET=dev-only-change-me
ENVIRONMENT=development
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
WORKER_POLL_SECONDS=5
WORKER_MAX_ATTEMPTS=3
WORKER_LOCK_TIMEOUT_SECONDS=300
# Set true on hosts with no separate worker service (e.g. free tiers): the reminder worker then runs inside the API.
RUN_WORKER_IN_API=false
# There is deliberately no OpenRouter key here: every user brings their own.

# --- Frontend (only needed when the API is on another origin; dev uses the Vite proxy) ---
# VITE_API_URL=https://api.example.com
